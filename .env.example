# =============================================================================
# Be'energies — environment variables
# Copy this file to `.env.local` (dev) and configure them in Vercel for prod.
# =============================================================================

# --- Contact form (Resend) ---
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Sender. MUST be a verified domain in Resend (e.g. noreply@be-energies.be).
# Resend's onboarding sandbox sender (onboarding@resend.dev) also works during
# initial testing.
CONTACT_FROM_EMAIL="Be'energies <noreply@be-energies.be>"

# Recipient(s). Comma-separated to deliver the same lead to multiple inboxes.
CONTACT_TO_EMAIL="info@be-energies.be,benoit.dezso@be-energies.be"

# --- Lead-magnet PDF gate (Brevo + signed token) ---
# Brevo dashboard -> SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=

# Numeric list ID that will receive new lead-magnet subscribers.
# Brevo -> Contacts -> Lists -> open the list -> ID is in the URL (?id=NN).
BREVO_LEAD_MAGNET_LIST_ID=

# Optional. Defaults to CONTACT_FROM_EMAIL if unset. Must be a sender
# verified in Brevo (Brevo -> Senders, Domains & Dedicated IPs).
# BREVO_FROM_EMAIL="contact@be-energies.be"
# BREVO_FROM_NAME="Be'energies"

# 32+ char random secret used to sign short-lived PDF download tokens.
# Generate one with:  openssl rand -hex 32
LEAD_MAGNET_TOKEN_SECRET=

# Public base URL used to build the absolute download URL inside the
# confirmation email. Defaults to https://www.be-energies.be if unset.
# NEXT_PUBLIC_SITE_URL="https://www.be-energies.be"
